# Supabase - Get these from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App URL - REQUIRED for SEO (sitemap, robots, metadata, structured data)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Analytics (optional)
# NOTE: NEXT_PUBLIC_GA_ID is currently NOT read by the code — the GA measurement
# ID is hardcoded in app/components/GoogleAnalyticsWrapper.tsx. Making this
# variable real is part of openspec/changes/fix-analytics-consent/.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NOTE: setting NEXT_PUBLIC_FB_PIXEL_ID enables Meta Pixel for ALL visitors —
# it is not yet gated by the cookie-consent banner (GDPR risk, same change).
NEXT_PUBLIC_FB_PIXEL_ID=1234567890
